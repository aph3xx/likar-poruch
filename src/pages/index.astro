---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import articles from '../data/articles.json';
import serviceData from '../data/services.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phoneHref = `tel:${site.phone}`;
const services = serviceData.map((service, index) => ({
  number: String(index + 1).padStart(2, '0'),
  title: service.titleUk,
  text: service.summaryUk,
  points: service.itemsUk.slice(0, 3)
}));
const faq = [
  ['Кого приймає медичний центр?', 'Ми надаємо медичну допомогу дорослим і дітям. Обсяг конкретної консультації узгоджується під час запису.'],
  ['Як записатися на прийом?', `Зателефонуйте за номером ${site.phoneDisplay}. Адміністратор допоможе обрати консультацію та погодити час.`],
  ['Які обстеження можна пройти на місці?', 'Доступні ЕКГ із розшифруванням, вимірювання тиску і пульсу, швидкі тести, визначення глюкози та холестерину, отоскопія, перевірка гостроти зору й антропометрія.'],
  ['Що робити у невідкладному стані?', 'За загрози життю не чекайте планового прийому. Телефонуйте 103 або 112.']
];
const siteOrigin = Astro.site?.origin || 'https://aph3xx.github.io';
const schema = [
  {'@context':'https://schema.org','@type':'MedicalClinic','name':site.name,'url':`${siteOrigin}${base}/`,'telephone':site.phone,'description':site.tagline,'address':{'@type':'PostalAddress','streetAddress':'вул. Хоральська, 1А','addressCountry':'UA'},'medicalSpecialty':['PrimaryCare','Endocrinologic']},
  {'@context':'https://schema.org','@type':'WebSite','name':site.name,'url':`${siteOrigin}${base}/`,'inLanguage':'uk-UA'},
  {'@context':'https://schema.org','@type':'FAQPage','mainEntity':faq.map(([name,text])=>({'@type':'Question','name':name,'acceptedAnswer':{'@type':'Answer','text':text}}))}
];
---
<BaseLayout title="Лікар Поруч | Сімейний лікар та ендокринолог" description="Приватний медичний центр для дорослих і дітей: сімейний лікар, ендокринолог та швидка діагностика на вул. Хоральській, 1А." schema={schema} image="/images/clinic-doctor.webp">
  <section class="hero clinic-hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Медичний центр для всієї родини</p>
        <h1>Здоров’я ближче. <em>Лікар поруч.</em></h1>
        <p class="lead">Особиста медична допомога для дорослих і дітей: від першої консультації до діагностики та подальшого супроводу.</p>
        <div class="clinic-actions"><a class="button" href={`${base}/zapys/`}>Записатися на прийом</a><a class="button secondary" href={`${base}/posluhy/`}>Переглянути послуги</a></div>
        <div class="micro-trust"><span>Без черг і очікування</span><span>Діагностика на місці</span></div>
      </div>
      <div class="hero-photo clinic-photo"><img src={`${base}/images/clinic-doctor.webp`} width="475" height="720" alt="Лікарка медичного центру «Лікар Поруч»" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="section" id="posluhy"><div class="container">
    <div class="section-head"><div><p class="eyebrow">Допомога поруч</p><h2>Основні напрямки</h2></div><p class="lead">Зрозумілий маршрут пацієнта без зайвих переадресацій.</p></div>
    <div class="clinic-services">{services.map((service)=><article class="clinic-service"><span>{service.number}</span><h3>{service.title}</h3><p>{service.text}</p><ul>{service.points.map((point)=><li>{point}</li>)}</ul></article>)}</div>
    <div class="section-cta"><a class="button" href={`${base}/posluhy/`}>Усі послуги</a></div>
  </div></section>

  <section class="section section-ink"><div class="container trust-grid">
    <div><p class="eyebrow">Турбота без зайвого стресу</p><h2>Один медичний центр для щоденних потреб</h2><p class="lead">Індивідуальний підхід, зручний запис і сучасні методи обстеження у спокійній локальній практиці.</p><a class="button yellow" href={phoneHref}>Зателефонувати</a></div>
    <div class="method-list"><div class="method-item"><div><h3>Для дорослих і дітей</h3><p>Сімейна медицина з увагою до віку, історії здоров’я та потреб родини.</p></div></div><div class="method-item"><div><h3>Діагностика на місці</h3><p>Базові вимірювання, швидкі тести та ЕКГ без окремої поїздки до іншого закладу.</p></div></div><div class="method-item"><div><h3>Зручний запис</h3><p>Узгодьте час телефоном і приходьте на консультацію без живої черги.</p></div></div></div>
  </div></section>

  <section class="section contact-band"><div class="container contact-band-grid"><div><p class="eyebrow">Ми поруч</p><h2>{site.address}</h2><p class="lead">Зателефонуйте, щоб уточнити послугу та домовитися про зручний час прийому.</p></div><div class="contact-number"><span>Запис за телефоном</span><a href={phoneHref}>{site.phoneDisplay}</a><a class="text-link" href={`${base}/kontakty/`}>Контакти та маршрут →</a></div></div></section>

  <section class="section"><div class="container">
    <div class="section-head"><div><p class="eyebrow">Корисно знати</p><h2>Матеріали про здоров’я</h2></div><a class="text-link" href={`${base}/zhurnal/`}>Усі матеріали →</a></div>
    <div class="journal-grid">{articles.slice(0,3).map((article)=><a class="article-card" href={`${base}/zhurnal/${article.slug}/`}><span class="article-card-meta">{article.category} · {article.readingTime}</span><div><h3>{article.title}</h3><p>{article.description}</p></div><span class="text-link">Читати →</span></a>)}</div>
  </div></section>

  <section class="section section-ice"><div class="container narrow"><p class="eyebrow">Питання та відповіді</p><h2>Перед візитом</h2><div class="faq-list">{faq.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
</BaseLayout>

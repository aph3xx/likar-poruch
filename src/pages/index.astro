---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import site from '../data/site.json';
import articles from '../data/articles.json';
import serviceData from '../data/services.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phoneHref = `tel:${site.phone}`;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.address}, Київ`)}`;
const faq = [
  ['Кого приймає медичний центр?', 'Ми надаємо медичну допомогу дорослим і дітям. Обсяг конкретної консультації узгоджується під час запису.'],
  ['Як записатися на прийом?', `Заповніть форму, щоб зберегти локальну чернетку, а потім зателефонуйте за номером ${site.phoneDisplay}. Під час розмови узгодьте консультацію та час.`],
  ['Які обстеження можна пройти на місці?', 'Доступні ЕКГ із розшифруванням, вимірювання тиску і пульсу, швидкі тести, визначення глюкози та холестерину, отоскопія, перевірка гостроти зору й антропометрія.'],
  ['Що робити у невідкладному стані?', 'За загрози життю не чекайте планового прийому. Телефонуйте 103 або 112.'],
];
const siteOrigin = Astro.site?.origin || 'https://sur.kyiv.ua';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    '@id': `${siteOrigin}${base}/#medical-center`,
    name: site.name,
    url: `${siteOrigin}${base}/`,
    telephone: site.phone,
    description: site.tagline,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'вул. Хоральська, 1А',
      addressLocality: 'Київ',
      addressCountry: 'UA',
    },
    medicalSpecialty: ['PrimaryCare', 'Endocrinologic'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: `${siteOrigin}${base}/`,
    inLanguage: 'uk-UA',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  },
];
---
<BaseLayout
  title="Лікар Поруч | Сімейний лікар та ендокринолог"
  description="Приватний медичний центр для дорослих і дітей: сімейний лікар, ендокринолог та швидка діагностика на вул. Хоральській, 1А."
  image="/images/clinic-doctor.webp"
  schema={schema}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid" data-hero-grid>
      <div class="hero-copy">
        <p class="eyebrow">Приватний медичний центр у Києві</p>
        <h1 id="hero-title">Здоров’я ближче.<br /><em>Лікар поруч.</em></h1>
        <p class="lead">Сімейна медицина для дорослих і дітей, ендокринологія та швидка діагностика в одному місці.</p>
        <ul class="fact-chips" aria-label="Напрямки допомоги">
          <li>Дорослим і дітям</li>
          <li>Діагностика на місці</li>
          <li>Попередній запис</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href="#kontakty">Записатися на прийом</a>
          <a class="button button-quiet" href={phoneHref}>Зателефонувати</a>
        </div>
      </div>
      <aside class="hero-practice" aria-label="Контактна інформація центру">
        <div class="practice-brand">
          <img src={`${base}/brand/mark-inverse.svg`} alt="" width="54" height="60" />
          <span>Лікар Поруч</span>
        </div>
        <p>Особиста медична допомога поруч із домом</p>
        <dl>
          <div><dt>Адреса</dt><dd>{site.address}, Київ</dd></div>
          <div><dt>Запис</dt><dd><a href={phoneHref}>{site.phoneDisplay}</a></dd></div>
          <div><dt>Формат</dt><dd>Приватна медична практика</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section services-section" id="posluhy" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Коли потрібна допомога</p>
          <h2 id="services-title">Три напрямки, один зрозумілий маршрут</h2>
        </div>
        <p class="lead">Почніть із вашої потреби. Під час запису ми допоможемо обрати відповідний формат прийому.</p>
      </div>
      <div class="service-grid" data-service-grid>
        {serviceData.map((service, index) => (
          <article class="service-card">
            <div class="service-number">0{index + 1}</div>
            <h3>{service.titleUk}</h3>
            <p>{service.summaryUk}</p>
            <ul>{service.itemsUk.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
            <a href={`${base}/posluhy/#${service.slug}`}>Що входить <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section team-section" id="likari" aria-labelledby="team-title">
    <div class="container team-layout">
      <div class="team-copy">
        <p class="eyebrow">Лікарі центру</p>
        <h2 id="team-title">Команда для щоденної та тривалої турботи</h2>
        <p class="lead">Напрямок лікаря добирається відповідно до вашого запиту. Конкретного фахівця та доступний час узгодимо телефоном.</p>
        <a class="text-link" href="#kontakty">Поставити запитання про запис</a>
      </div>
      <div class="role-list">
        <article>
          <span>Первинна допомога</span>
          <h3>Сімейна медицина</h3>
          <p>Консультації дорослих і дітей, профілактика, супровід хронічних станів та план наступних кроків.</p>
        </article>
        <article>
          <span>Профільна консультація</span>
          <h3>Ендокринологія</h3>
          <p>Допомога при захворюваннях щитоподібної залози, діабеті, метаболічних і гормональних порушеннях.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section diagnostics-section" id="diagnostyka" aria-labelledby="diagnostics-title">
    <div class="container diagnostics-layout">
      <div>
        <p class="eyebrow eyebrow-light">Діагностика на місці</p>
        <h2 id="diagnostics-title">Менше зайвих поїздок, швидше до наступного кроку</h2>
        <p class="lead">Базові обстеження можна провести під час звернення до центру. Доступність конкретної процедури уточнюйте під час запису.</p>
        <a class="button button-light" href={phoneHref}>Уточнити телефоном</a>
      </div>
      <ul class="diagnostics-list">
        {serviceData[2].itemsUk.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section about-section" id="pro-tsentr" aria-labelledby="about-title">
    <div class="container about-layout">
      <div>
        <p class="eyebrow">Про центр</p>
        <h2 id="about-title">Медична допомога без зайвої складності</h2>
      </div>
      <div class="about-copy">
        <p class="lead">Ми поєднуємо первинну допомогу, профільну консультацію та базову діагностику, щоб пацієнт отримав зрозумілий план дій в одному місці.</p>
        <div class="care-principles">
          <div><strong>До візиту</strong><p>Збережіть локальну чернетку, а послугу, дату й час узгодьте телефоном.</p></div>
          <div><strong>Під час прийому</strong><p>Збираємо інформацію, проводимо огляд і пояснюємо наступні кроки.</p></div>
          <div><strong>Після запиту</strong><p>Після телефонної розмови узгоджений час стане вашим записом. Заповнена форма сама по собі не є підтвердженням.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section contact-section" id="kontakty" aria-labelledby="contact-title">
    <div class="container">
      <div class="section-head compact">
        <div><p class="eyebrow">Запис і контакти</p><h2 id="contact-title">Оберіть зручний спосіб зв’язку</h2></div>
        <p class="lead">Для запису достатньо контактних даних, послуги та бажаного часу. Не надсилайте медичні документи або діагнози.</p>
      </div>
      <div class="contact-grid" data-contact-grid>
        <div class="visit-card">
          <div><span class="meta-label">Телефон</span><a class="visit-phone" href={phoneHref}>{site.phoneDisplay}</a></div>
          <div><span class="meta-label">Адреса</span><p>{site.address}, Київ</p><a class="text-link" href={mapUrl} target="_blank" rel="noopener">Побудувати маршрут</a></div>
          <div class="expectation"><strong>Що буде після запиту</strong><p>Після збереження локальної чернетки зателефонуйте до клініки, щоб передати запит і узгодити послугу, дату та час.</p></div>
          <div class="urgent"><strong>Невідкладний стан</strong><p>За загрози життю телефонуйте 103 або 112.</p></div>
        </div>
        <AppointmentForm compact={true} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="journal-title">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Корисно знати</p><h2 id="journal-title">Матеріали про здоров’я</h2></div>
        <a class="text-link" href={`${base}/zhurnal/`}>Усі матеріали <span aria-hidden="true">→</span></a>
      </div>
      <div class="journal-grid">
        {articles.slice(0, 3).map((article) => (
          <a class="article-card" href={`${base}/zhurnal/${article.slug}/`}>
            <span class="article-card-meta">{article.category} · {article.readingTime}</span>
            <div><h3>{article.title}</h3><p>{article.description}</p></div>
            <span class="text-link">Матеріал: {article.category} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="container narrow">
      <p class="eyebrow">Перед візитом</p>
      <h2 id="faq-title">Питання та відповіді</h2>
      <div class="faq-list">{faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </div>
  </section>
</BaseLayout>

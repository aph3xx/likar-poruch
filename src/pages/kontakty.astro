---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../data/site.json';
const mapUrl=`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.address}, Київ`)}`;
const siteOrigin = Astro.site?.origin || 'https://sur.kyiv.ua';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const schema={'@context':'https://schema.org','@type':'MedicalClinic','@id':`${siteOrigin}${base}/#medical-center`,'name':site.name,'url':`${siteOrigin}${base}/`,'telephone':site.phone,'address':{'@type':'PostalAddress','streetAddress':site.address,'addressLocality':'Київ','addressCountry':'UA'}};
---
<BaseLayout title="Контакти та запис | Лікар Поруч" description="Контакти медичного центру Лікар Поруч. Адреса: вул. Хоральська, 1А. Запис телефоном 093 108 00 95." path="kontakty" schema={schema}>
<section class="page-hero"><div class="container"><Breadcrumbs items={[{label:'Головна',href:'/'},{label:'Контакти'}]} /><p class="eyebrow">Контакти</p><h1>Домовтеся про зручний час прийому</h1><p class="lead">Перед візитом зателефонуйте, щоб уточнити послугу, доступний час і підготовку до обстеження.</p></div></section>
<section class="section"><div class="container contact-page-grid"><div class="contact-primary"><span>Запис на прийом</span><h2>Надішліть короткий запит</h2><p>Збережіть локальну чернетку з ім’ям, телефоном і бажаними датою та часом, а потім зателефонуйте до клініки.</p><a class="button" href={`${import.meta.env.BASE_URL}zapys/`}>Заповнити форму</a><a class="text-link" href={`tel:${site.phone}`}>Або зателефонувати: {site.phoneDisplay}</a></div><div class="contact-address"><span>Адреса</span><h2>{site.address}, Київ</h2><a class="button secondary" href={mapUrl} target="_blank" rel="noopener">Побудувати маршрут</a></div></div></section>
<section class="section section-ice"><div class="container narrow"><p class="eyebrow">Перед дзвінком</p><h2>Що варто повідомити</h2><div class="faq-list"><details open><summary>Кого потрібно записати</summary><p>Скажіть, консультація потрібна дорослому чи дитині, та коротко опишіть основний запит.</p></details><details><summary>Яка послуга вас цікавить</summary><p>Сімейний лікар, консультація ендокринолога або діагностичне обстеження.</p></details><details><summary>Чи є невідкладні симптоми</summary><p>За загрози життю не чекайте запису. Телефонуйте 103 або 112.</p></details></div></div></section>
</BaseLayout>

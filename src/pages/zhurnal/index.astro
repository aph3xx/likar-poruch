---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import articles from '../../data/articles.json';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const siteOrigin=Astro.site?.origin || 'https://aph3xx.github.io';
const schema={'@context':'https://schema.org','@type':'Blog','name':'Журнал Лікар Поруч','description':'Практичні матеріали про вибір лікаря та підготовку до консультації','blogPost':articles.map(a=>({'@type':'BlogPosting','headline':a.title,'url':`${siteOrigin}${base}/zhurnal/${a.slug}/`,'datePublished':a.published,'dateModified':a.updated}))};
---
<BaseLayout title="Журнал здоров’я | Лікар Поруч" description="Практичні матеріали українською про вибір лікаря, підготовку до консультації, доказову медицину та невідкладні стани." path="/zhurnal/" schema={schema}>
  <section class="page-hero"><div class="container"><Breadcrumbs items={[{label:'Головна',href:'/'},{label:'Журнал'}]} /><p class="eyebrow">Редакційні матеріали</p><h1>Здоров’я без інформаційного шуму</h1><p class="lead">Пояснюємо, як підготуватися до консультації, оцінити рекомендації та вчасно звернутися по допомогу.</p></div></section>
  <section class="section"><div class="container"><div class="journal-grid">{articles.map(article=><a class="article-card" href={`${base}/zhurnal/${article.slug}/`}><span class="article-card-meta">{article.category} · {article.readingTime}</span><div><h2 style="font-size:clamp(1.35rem,2.2vw,2rem)">{article.title}</h2><p>{article.description}</p></div><span class="text-link">Матеріал: {article.category} →</span></a>)}</div></div></section>
  <section class="section-compact section-ice"><div class="container narrow"><div class="callout"><strong>Медичне застереження</strong><p>Матеріали журналу мають освітній характер і не замінюють індивідуальну консультацію. За загрози життю телефонуйте 103 або 112.</p></div></div></section>
</BaseLayout>

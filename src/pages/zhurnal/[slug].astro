---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import articles from '../../data/articles.json';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const canonical=`https://aph3xx.github.io${base}/zhurnal/${article.slug}/`;
const schema=[{'@context':'https://schema.org','@type':'MedicalWebPage','name':article.title,'description':article.description,'datePublished':article.published,'dateModified':article.updated,'inLanguage':'uk-UA','lastReviewed':article.updated,'reviewedBy':{'@type':'Organization','name':article.reviewer},'mainEntity':{'@type':'Article','headline':article.title,'author':{'@type':'Organization','name':article.author},'publisher':{'@type':'Organization','name':'Лікар Поруч'},'datePublished':article.published,'dateModified':article.updated}}, {'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Головна','item':`https://aph3xx.github.io${base}/`},{'@type':'ListItem','position':2,'name':'Журнал','item':`https://aph3xx.github.io${base}/zhurnal/`},{'@type':'ListItem','position':3,'name':article.title,'item':canonical}]}];
---
<BaseLayout title={`${article.title} | Лікар Поруч`} description={article.description} path={`/zhurnal/${article.slug}/`} type="article" schema={schema}>
  <article>
    <header class="page-hero"><div class="container article-header"><Breadcrumbs items={[{label:'Головна',href:'/'},{label:'Журнал',href:'/zhurnal/'},{label:article.title}]} /><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="lead">{article.description}</p><div class="article-byline"><span>{article.author}</span><span>Медична перевірка: {article.reviewer}</span><span>{article.readingTime}</span><time datetime={article.updated}>Оновлено {new Intl.DateTimeFormat('uk-UA',{dateStyle:'long'}).format(new Date(article.updated))}</time></div></div></header>
    <div class="section-compact"><div class="container narrow content-copy"><p class="article-intro">{article.intro}</p>{article.sections.map(section=><section><h2>{section.heading}</h2><p>{section.text}</p></section>)}<div class="callout"><strong>Цей матеріал не замінює консультацію</strong><p>Інформація є загальною. Якщо симптоми викликають тривогу або погіршуються, зверніться до лікаря. За загрози життю телефонуйте 103 або 112.</p></div><p><a class="button" href={`${base}/kontakty/`}>Записатися на консультацію</a></p></div></div>
  </article>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const steps=[['Сформулюйте потребу','Оберіть спеціальність або почніть із сімейного лікаря, якщо не впевнені.'],['Порівняйте профілі','Звертайте увагу на фокус практики, місто, формат консультації та мови.'],['Перевірте деталі','Перед реальним записом уточніть право на практику, адресу, ціну та правила клініки.'],['Підготуйтеся','Запишіть симптоми, ліки, результати обстежень і головні запитання.']];
---
<BaseLayout title="Як знайти лікаря | Як працює Лікар Поруч" description="Чотири кроки до консультації: визначте потребу, порівняйте профілі, перевірте деталі та підготуйте запитання." path="/yak-tse-pratsiuie/">
  <section class="page-hero"><div class="container"><Breadcrumbs items={[{label:'Головна',href:'/'},{label:'Як це працює'}]} /><p class="eyebrow">Чотири кроки</p><h1>Від запиту до консультації без зайвого шуму</h1><p class="lead">Ми відділяємо факти від реклами та пояснюємо кожен етап вибору.</p></div></section>
  <section class="section"><div class="container"><div class="method-list" style="border-color:var(--line)">{steps.map(([title,text])=><div class="method-item" style="border-color:var(--line)"><div><h2 style="font-size:1.8rem">{title}</h2><p>{text}</p></div></div>)}</div></div></section>
  <section class="section section-ink"><div class="container trust-grid"><div><p class="eyebrow">Модель довіри</p><h2>Що має перевіряти майбутній сервіс</h2></div><div class="content-copy"><p>Освіту й спеціалізацію, поточне місце практики, актуальність контактів та походження відгуку. Біля кожного твердження має бути зрозуміло, коли воно оновлене.</p><p>Спонсоровані позиції повинні мати помітне маркування й не впливати на органічне сортування.</p></div></div></section>
</BaseLayout>

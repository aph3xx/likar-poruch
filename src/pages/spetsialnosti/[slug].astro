---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import doctors from '../../data/doctors.json';
const specialties={
 'simeinyi-likar':{name:'Сімейний лікар',title:'Сімейні лікарі в Україні',desc:'Сімейний лікар допомагає з профілактикою, гострими станами, хронічними захворюваннями та направленням до вузьких спеціалістів.',when:['потрібен профілактичний огляд','тривалий супровід хронічного стану','незрозуміло, до якого спеціаліста звернутися'],aliases:['сімейна лікарка']},
 'pediatr':{name:'Педіатр',title:'Педіатри в Україні',desc:'Педіатр супроводжує здоров’я дитини, оцінює розвиток, допомагає з вакцинацією та лікуванням поширених захворювань.',when:['потрібен плановий огляд дитини','є питання щодо вакцинації','дитина захворіла або змінилася її поведінка']},
 'kardioloh':{name:'Кардіолог',title:'Кардіологи в Україні',desc:'Кардіолог оцінює стан серця й судин, фактори ризику та допомагає контролювати артеріальний тиск і порушення ритму.',when:['турбує тиск або серцебиття','є біль у грудях без ознак невідкладного стану','потрібна оцінка серцево-судинного ризику'],aliases:['кардіологиня']},
 'dermatoloh':{name:'Дерматолог',title:'Дерматологи в Україні',desc:'Дерматолог діагностує захворювання шкіри, волосся та нігтів, проводить профілактичні огляди новоутворень.',when:['висип або свербіж не минає','турбує родимка чи інше новоутворення','потрібна допомога з акне'],aliases:['дерматолог']},
 'hinekoloh':{name:'Гінеколог',title:'Гінекологи в Україні',desc:'Гінеколог допомагає з профілактикою, репродуктивним здоров’ям, контрацепцією та плануванням вагітності.',when:['час профілактичного огляду','є зміни циклу або біль','потрібна консультація щодо контрацепції'],aliases:['гінекологиня']},
 'nevroloh':{name:'Невролог',title:'Неврологи в Україні',desc:'Невролог оцінює головний біль, порушення чутливості, біль у спині та інші симптоми нервової системи.',when:['частий або незвичний головний біль','є оніміння чи слабкість без гострого початку','тривало турбує біль у спині'],aliases:['невролог']}
};
export function getStaticPaths(){return ['simeinyi-likar','pediatr','kardioloh','dermatoloh','hinekoloh','nevroloh'].map(slug=>({params:{slug}}));}
const slug=Astro.params.slug as keyof typeof specialties; const data=specialties[slug]; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const matches=doctors.filter(d=>d.specialtySlug===slug);
const schema={'@context':'https://schema.org','@type':'MedicalWebPage','name':data.title,'description':data.desc,'inLanguage':'uk-UA','url':`https://aph3xx.github.io${base}/spetsialnosti/${slug}/`};
---
<BaseLayout title={`${data.title} | Каталог Лікар Поруч`} description={`${data.desc} Перегляньте демонстраційні профілі та дізнайтеся, як підготуватися до консультації.`} path={`/spetsialnosti/${slug}/`} schema={schema}>
  <section class="page-hero"><div class="container"><Breadcrumbs items={[{label:'Головна',href:'/'},{label:'Спеціальності',href:'/likari/'},{label:data.name}]} /><p class="eyebrow">Спеціальність</p><h1>{data.title}</h1><p class="lead">{data.desc}</p></div></section>
  <section class="section-compact"><div class="container profile-grid"><div><h2>Коли звернутися</h2><ul class="content-copy">{data.when.map(item=><li>{item}</li>)}</ul><div class="callout"><strong>Невідкладний стан?</strong><p>За раптової слабкості, порушення мовлення, сильного болю у грудях, тяжкої задишки або втрати свідомості телефонуйте 103 чи 112.</p></div></div><aside><h2>Підготовка</h2><p>Візьміть перелік ліків, попередні висновки та коротку хронологію симптомів. Запишіть запитання заздалегідь.</p></aside></div></section>
  <section class="section section-ice"><div class="container"><div class="section-head"><div><p class="eyebrow">Каталог</p><h2>{matches.length ? 'Профілі для перегляду' : 'Профілі готуються'}</h2></div></div><div class="doctor-list">{matches.map(d=><DoctorCard doctor={d} />)}</div></div></section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import doctors from '../../data/doctors.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const schema = {'@context':'https://schema.org','@type':'ItemList','name':'Демонстраційний каталог лікарів','itemListElement':doctors.map((d,i)=>({'@type':'ListItem','position':i+1,'url':`https://aph3xx.github.io${base}/likari/${d.slug}/`,'name':d.name}))};
---
<BaseLayout title="Лікарі України за спеціальністю та містом | Лікар Поруч" description="Знайдіть лікаря у Києві, Львові або Одесі. Фільтруйте демонстраційні профілі за спеціальністю, містом і форматом консультації." path="/likari/" schema={schema}>
  <section class="page-hero"><div class="container"><Breadcrumbs items={[{label:'Головна',href:'/'},{label:'Лікарі'}]} /><p class="eyebrow">Каталог</p><h1>Знайдіть лікаря під свій запит</h1><p class="lead">Порівнюйте спеціальність, фокус практики та формат прийому. Усі профілі на цій версії є демонстраційними.</p></div></section>
  <section class="section-compact"><div class="container">
    <div class="demo-alert"><strong>Демонстраційні дані.</strong> Імена, досвід і напрями практики нижче створені для показу інтерфейсу.</div>
    <div class="filter-bar" aria-label="Фільтри лікарів">
      <input id="doctor-search" type="search" placeholder="Ім’я або спеціальність" aria-label="Пошук за ім’ям або спеціальністю" />
      <select id="specialty-filter" aria-label="Спеціальність"><option value="">Усі спеціальності</option>{[...new Set(doctors.map(d=>d.specialty))].map(s=><option value={s.toLowerCase()}>{s}</option>)}</select>
      <select id="city-filter" aria-label="Місто"><option value="">Усі міста</option>{[...new Set(doctors.map(d=>d.city))].map(c=><option value={c.toLowerCase()}>{c}</option>)}</select>
    </div>
    <p id="result-count" class="result-count" aria-live="polite">Знайдено: {doctors.length}</p>
    <div class="doctor-list" id="doctor-list">{doctors.map((doctor)=><DoctorCard doctor={doctor} />)}</div>
    <div class="empty-state" id="empty-state" hidden><h2>Нічого не знайдено</h2><p>Спробуйте іншу спеціальність, місто або коротший запит.</p></div>
  </div></section>
  <script is:inline>
    const q = document.querySelector('#doctor-search'); const specialty = document.querySelector('#specialty-filter'); const city = document.querySelector('#city-filter');
    const cards = [...document.querySelectorAll('[data-doctor]')]; const count = document.querySelector('#result-count'); const empty = document.querySelector('#empty-state');
    const params = new URLSearchParams(location.search); const slugMap = {'simeinyi-likar':'сімейна лікарка','pediatr':'педіатр','kardioloh':'кардіологиня','dermatoloh':'дерматолог','hinekoloh':'гінекологиня','nevroloh':'невролог'}; const cityMap = {'kyiv':'київ','lviv':'львів','odesa':'одеса'};
    if(params.get('specialty')) specialty.value = slugMap[params.get('specialty')] || ''; if(params.get('city')) city.value = cityMap[params.get('city')] || ''; if(params.get('q')) q.value=params.get('q');
    function filter(){const text=q.value.trim().toLowerCase();let visible=0;cards.forEach(card=>{const show=(!text||(card.dataset.name+' '+card.dataset.specialty).includes(text))&&(!specialty.value||card.dataset.specialty===specialty.value)&&(!city.value||card.dataset.city===city.value);card.hidden=!show;if(show) visible++});count.textContent='Знайдено: '+visible;empty.hidden=visible!==0;}
    [q,specialty,city].forEach(el=>el.addEventListener('input',filter)); filter();
  </script>
</BaseLayout>

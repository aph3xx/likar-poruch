---
import BaseLayout from '../layouts/BaseLayout.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="Сторінку не знайдено | Лікар Поруч" description="Такої сторінки немає. Поверніться на головну сторінку медичного центру Лікар Поруч." path="404" noindex={true}>
  <section class="not-found"><strong>404</strong><h1>Сторінку не знайдено</h1><p class="lead" style="margin-inline:auto">Посилання могло змінитися. Перейдіть на головну або зателефонуйте нам.</p><a class="button" href={`${base}/`}>На головну</a></section>
</BaseLayout>

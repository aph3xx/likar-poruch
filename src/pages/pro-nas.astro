---
import BaseLayout from '../layouts/BaseLayout.astro';import Breadcrumbs from '../components/Breadcrumbs.astro';import site from '../data/site.json';
---
<BaseLayout title="Про медичний центр | Лікар Поруч" description="Лікар Поруч: приватна медична практика для дорослих і дітей із сімейною медициною, ендокринологією та діагностикою на місці." path="pro-nas">
<section class="page-hero"><div class="container"><Breadcrumbs items={[{label:'Головна',href:'/'},{label:'Про центр'}]} /><p class="eyebrow">Про медичний центр</p><h1>Особиста турбота замість безликої системи</h1><p class="lead">«Лікар Поруч» допомагає дорослим і дітям отримати консультацію, базову діагностику та зрозумілий план наступних кроків в одному місці.</p></div></section>
<section class="section"><div class="container trust-grid"><div><h2>Медицина, до якої легко звернутися</h2><p class="lead">Ми будуємо прийом навколо конкретної людини: уважно вислухати, пояснити рішення простою мовою і не залишити пацієнта наодинці з незрозумілими результатами.</p></div><div class="method-list light"><div class="method-item"><div><h3>Індивідуальний підхід</h3><p>Рішення з урахуванням віку, історії здоров’я і способу життя.</p></div></div><div class="method-item"><div><h3>Без черг</h3><p>Попередній запис допомагає планувати візит без зайвого очікування.</p></div></div><div class="method-item"><div><h3>Обстеження на місці</h3><p>Базові вимірювання й швидка діагностика під час звернення.</p></div></div></div></div></section>
<section class="section section-ice"><div class="container contact-band-grid"><div><p class="eyebrow">Завітайте до нас</p><h2>{site.address}</h2></div><div class="contact-number"><span>Запис</span><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></div></div></section>
</BaseLayout>

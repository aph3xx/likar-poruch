---
import RussianLayout from '../../layouts/RussianLayout.astro';
import site from '../../data/site-ru.json';
import serviceData from '../../data/services.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = site.phone;
const phoneDisplay = site.phoneDisplay;
---
<RussianLayout
  title="Частный медицинский центр в Киеве | Лікар Поруч"
  description="Частный медицинский центр «Лікар Поруч» в Киеве: семейный врач, эндокринолог и быстрая диагностика. Адрес: ул. Хоральская, 1А."
  path="/ru/"
  ukPath="/"
>
  <section class="hero" aria-labelledby="ru-hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Частный медицинский центр в Киеве</p>
        <h1 id="ru-hero-title">Здоровье ближе.<br /><em>Врач рядом.</em></h1>
        <p class="lead">Семейная медицина для взрослых и детей, эндокринология и быстрая диагностика в одном месте.</p>
        <ul class="fact-chips" aria-label="Направления помощи"><li>Взрослым и детям</li><li>Диагностика на месте</li><li>Предварительная запись</li></ul>
        <div class="hero-actions"><a class="button" href={`${base}/ru/zapis/`}>Записаться на приём</a><a class="button button-quiet" href={`tel:${phone}`}>Позвонить</a></div>
      </div>
      <aside class="hero-practice" aria-label="Контактная информация центра">
        <div class="practice-brand"><img src={`${base}/brand/mark-inverse.svg`} alt="" width="54" height="60" /><span>Лікар Поруч</span></div>
        <p>Личная медицинская помощь рядом с домом</p>
        <dl>
          <div><dt>Адрес</dt><dd>{site.address}, Киев</dd></div>
          <div><dt>Запись</dt><dd><a href={`tel:${phone}`}>{phoneDisplay}</a></dd></div>
          <div><dt>Формат</dt><dd>Частная медицинская практика</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section services-section" id="uslugi">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Когда нужна помощь</p><h2>Три направления, один понятный маршрут</h2></div><p class="lead">Во время записи администратор поможет выбрать подходящий формат приёма.</p></div>
      <div class="service-grid">
        {serviceData.map((service, index) => (
          <article class="service-card">
            <div class="service-number">0{index + 1}</div>
            <h3>{service.titleRu}</h3>
            <p>{service.summaryRu}</p>
            <ul>{service.itemsRu.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
            <a href={`${base}/ru/uslugi/`}>Подробнее <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section diagnostics-section">
    <div class="container diagnostics-layout">
      <div><p class="eyebrow eyebrow-light">Забота без лишнего стресса</p><h2>Один центр для повседневных медицинских вопросов</h2><p class="lead">Согласуйте консультацию и время визита напрямую с медицинским центром.</p><a class="button button-light" href={`tel:${phone}`}>Позвонить</a></div>
      <ul class="diagnostics-list"><li><span>01</span>Семейная медицина для взрослых и детей</li><li><span>02</span>Консультации эндокринолога</li><li><span>03</span>Базовая диагностика на месте</li></ul>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-band-grid">
      <div><p class="eyebrow">Мы рядом</p><h2>{site.address}, Киев</h2><p class="lead">Уточните подходящую услугу и договоритесь о времени приёма.</p></div>
      <div class="visit-card"><div><span class="meta-label">Запись по телефону</span><a class="visit-phone" href={`tel:${phone}`}>{phoneDisplay}</a></div><div><a class="button" href={`${base}/ru/zapis/`}>Оставить запрос</a></div></div>
    </div>
  </section>
</RussianLayout>

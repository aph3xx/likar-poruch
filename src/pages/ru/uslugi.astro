---
import RussianLayout from '../../layouts/RussianLayout.astro';
import site from '../../data/site-ru.json';
import serviceData from '../../data/services.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const phone = site.phone;
const phoneDisplay = site.phoneDisplay;
const services = serviceData.map((service) => ({title: service.titleRu, intro: service.summaryRu, items: service.itemsRu}));
---
<RussianLayout
  title="Услуги медицинского центра в Киеве | Лікар Поруч"
  description="Семейный врач для взрослых и детей, эндокринолог и быстрая диагностика в частном медицинском центре на ул. Хоральской, 1А в Киеве."
  path="/ru/uslugi/"
  ukPath="/posluhy/"
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Навигационная цепочка"><a href={`${import.meta.env.BASE_URL}ru/`}>Главная</a><span aria-hidden="true">/</span><span aria-current="page">Услуги</span></nav>
      <p class="eyebrow">Частный медицинский центр в Киеве</p>
      <h1>Услуги для повседневной заботы о здоровье</h1>
      <p class="lead">Семейная медицина, эндокринология и быстрая диагностика в одном центре. Доступность конкретной услуги уточняйте по телефону.</p>
    </div>
  </section>
  <section class="section">
    <div class="container service-detail-list">
      {services.map((service, index) => (
        <article class="service-detail">
          <span>0{index + 1}</span>
          <div><h2>{service.title}</h2><p class="lead">{service.intro}</p></div>
          <ul>{service.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
  <section class="section section-ink">
    <div class="container contact-band-grid">
      <div><p class="eyebrow">Запись на приём</p><h2>Поможем выбрать нужную консультацию</h2><p class="lead">Заполните короткую форму или позвоните, чтобы согласовать детали.</p><div class="clinic-actions"><a class="button yellow" href={`${base}/ru/zapis/`}>Записаться онлайн</a><a class="button secondary" href={`tel:${phone}`}>Позвонить</a></div></div>
      <div class="contact-number"><span>Телефон</span><a href={`tel:${phone}`}>{phoneDisplay}</a><p>ул. Хоральская, 1А, Киев</p></div>
    </div>
  </section>
</RussianLayout>

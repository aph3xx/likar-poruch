---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section class:list={['appointment-card', { compact }]} aria-labelledby="appointment-form-title">
  <div class="form-heading">
    <p class="form-kicker">Запит на запис</p>
    <h2 id="appointment-form-title">{compact ? 'Надішліть запит' : 'Залиште запит на прийом'}</h2>
    <p>Ми отримаємо ваш запит на запис. Не додавайте медичні дані — форма містить лише необхідну контактну інформацію.</p>
  </div>

  <form class="appointment-form" method="post" action={`${import.meta.env.BASE_URL}api/booking-requests`} data-appointment-form novalidate>
    <div class="error-summary" data-error-summary role="alert" tabindex="-1" hidden>
      <strong>Перевірте, будь ласка, дані</strong>
      <ul data-error-list></ul>
    </div>

    <div class="field field-wide">
      <label for="booking-name">Ім’я та прізвище <span aria-hidden="true">*</span></label>
      <input id="booking-name" name="name" type="text" autocomplete="name" maxlength="80" aria-describedby="booking-name-hint booking-name-error" data-validate required />
      <span class="field-hint" id="booking-name-hint">Як до вас звертатися.</span>
      <span class="field-error" id="booking-name-error"></span>
    </div>

    <div class="field field-wide">
      <label for="booking-phone">Номер телефона <span aria-hidden="true">*</span></label>
      <input id="booking-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" aria-describedby="booking-phone-hint booking-phone-error" data-validate required />
      <span class="field-hint" id="booking-phone-hint">Вкажіть номер із кодом країни або оператора.</span>
      <span class="field-error" id="booking-phone-error"></span>
    </div>

    <div class="field field-wide">
      <label for="booking-date">Бажана дата <span aria-hidden="true">*</span></label>
      <input id="booking-date" name="date" type="date" aria-describedby="booking-date-hint booking-date-error" data-validate required />
      <span class="field-hint" id="booking-date-hint">Оберіть сьогоднішню або майбутню дату.</span>
      <span class="field-error" id="booking-date-error"></span>
    </div>

    <div class="privacy-note field-wide">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24"><path d="M12 3 5.5 5.6v5.7c0 4.4 2.7 8.3 6.5 9.7 3.8-1.4 6.5-5.3 6.5-9.7V5.6L12 3Zm0 2.2 4.5 1.8v4.3c0 3.3-1.9 6.3-4.5 7.5-2.6-1.2-4.5-4.2-4.5-7.5V7L12 5.2Z" /></svg>
      <p><strong>Безпечний запит.</strong> Дані надсилаються до медичного центру для опрацювання запиту на запис. Не додавайте діагнози чи результати обстежень.</p>
    </div>

    <div class="form-actions field-wide">
      <button class="submit-button" type="submit">
        <span data-submit-label>Надіслати запит на запис</span>
        <span aria-hidden="true">→</span>
      </button>
      <p>Запит не є підтвердженим записом.</p>
    </div>

    <p class="submit-status field-wide" data-submit-status role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  document.querySelectorAll('[data-appointment-form]').forEach((node) => {
    if (!(node instanceof HTMLFormElement) || node.dataset.enhanced === 'true') return;
    node.dataset.enhanced = 'true';
    const form = node;
    type BookingField = HTMLInputElement;
    const fields = Array.from(form.querySelectorAll<BookingField>('[data-validate]'));
    const dateField = form.elements.namedItem('date');
    const summary = form.querySelector('[data-error-summary]');
    const errorList = form.querySelector('[data-error-list]');
    const status = form.querySelector('[data-submit-status]');
    const submit = form.querySelector('button[type="submit"]');
    const submitLabel = form.querySelector('[data-submit-label]');
    const endpoint = `${import.meta.env.BASE_URL}api/booking-requests`;
    let startedEventSent = false;
    let submitting = false;

    if (dateField instanceof HTMLInputElement) dateField.min = new Date().toISOString().slice(0, 10);

    const dispatchStarted = () => {
      if (startedEventSent) return;
      startedEventSent = true;
      window.dispatchEvent(new CustomEvent('likar:booking_started', { detail: { form: 'appointment_request' } }));
    };

    const errorMessage = (field: BookingField) => {
      const value = field.value.trim();
      if (field.name === 'name') {
        if (!value) return 'Вкажіть ім’я та прізвище.';
        if (Array.from(value).filter((character) => /\p{L}/u.test(character)).length < 2) return 'Введіть щонайменше дві літери.';
      }
      if (field.name === 'phone') {
        if (!value) return 'Вкажіть номер телефона.';
        if (!/^\+?[\d\s().-]+$/.test(value)) return 'Використовуйте лише цифри та символи + ( ) . -';
        const digitCount = value.replace(/\D/g, '').length;
        if (digitCount < 10 || digitCount > 15) return 'Введіть номер, що містить від 10 до 15 цифр.';
      }
      if (field.name === 'date') {
        if (!value) return 'Оберіть бажану дату.';
        if (field.validity.badInput || (dateField instanceof HTMLInputElement && value < dateField.min)) return 'Оберіть сьогоднішню або майбутню дату.';
      }
      return '';
    };

    const validateField = (field: BookingField) => {
      const message = errorMessage(field);
      const error = document.getElementById(`${field.id}-error`);
      field.setCustomValidity(message);
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (error) error.textContent = message;
      return !message;
    };

    const hideSummary = () => {
      if (summary instanceof HTMLElement) summary.hidden = true;
      if (errorList) errorList.replaceChildren();
    };

    form.addEventListener('input', (event) => {
      dispatchStarted();
      const field = event.target;
      if (field instanceof HTMLInputElement && field.matches('[data-validate]') && field.getAttribute('aria-invalid') === 'true') validateField(field);
    });
    form.addEventListener('change', (event) => {
      dispatchStarted();
      const field = event.target;
      if (field instanceof HTMLInputElement && field.matches('[data-validate]')) validateField(field);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      hideSummary();
      const invalidFields = fields.filter((field) => !validateField(field));
      if (invalidFields.length) {
        invalidFields.forEach((field) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${field.id}`;
          link.textContent = errorMessage(field);
          item.append(link);
          errorList?.append(item);
        });
        if (summary instanceof HTMLElement) {
          summary.hidden = false;
          summary.focus();
        }
        return;
      }

      submitting = true;
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Надсилаємо…';
      if (status) status.textContent = 'Надсилаємо запит…';
      const data = new FormData(form);
      const request = { name: String(data.get('name')).trim(), phone: String(data.get('phone')).trim(), date: String(data.get('date')) };
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(request),
        });
        if (!response.ok) throw new Error(response.status === 429 ? 'rate_limited' : 'server_error');
        window.dispatchEvent(new CustomEvent('likar:booking_submitted', { detail: { form: 'appointment_request' } }));
        if (status) status.textContent = 'Запит на запис надіслано. Він ще не є підтвердженим записом.';
        if (submitLabel) submitLabel.textContent = 'Надіслати ще один запит';
      } catch {
        if (status) status.textContent = 'Не вдалося надіслати запит. Перевірте з’єднання та спробуйте ще раз.';
        if (submitLabel) submitLabel.textContent = 'Спробувати ще раз';
      } finally {
        submitting = false;
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  });
</script>

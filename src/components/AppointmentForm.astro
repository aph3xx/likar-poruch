---
import serviceData from '../data/services.json';
import site from '../data/site.json';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const serviceOptions = serviceData.map((service) => service.titleUk);
---
<section class:list={['appointment-card', { compact }]} aria-labelledby="appointment-form-title">
  <div class="form-heading">
    <p class="form-kicker">Запит на запис</p>
    <h2 id="appointment-form-title">{compact ? 'Підготуйте SMS-запит' : 'Оберіть бажані дату й час'}</h2>
    <p>Перевірте заповнені дані перед надсиланням. Дату й час підтверджує адміністратор.</p>
  </div>

  <form class="appointment-form" data-appointment-form data-booking-endpoint={`sms:${site.phone}`} novalidate>
    <div class="error-summary" data-error-summary role="alert" tabindex="-1" hidden>
      <strong>Перевірте, будь ласка, дані</strong>
      <ul data-error-list></ul>
    </div>

    <div class="field field-wide">
      <label for="booking-name">Ім’я та прізвище <span aria-hidden="true">*</span></label>
      <input id="booking-name" name="name" type="text" autocomplete="name" maxlength="80" aria-describedby="booking-name-hint booking-name-error" data-validate required />
      <span class="field-hint" id="booking-name-hint">Як до вас звертатися під час підтвердження.</span>
      <span class="field-error" id="booking-name-error"></span>
    </div>

    <div class="field field-wide">
      <label for="booking-phone">Номер телефона <span aria-hidden="true">*</span></label>
      <input id="booking-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" aria-describedby="booking-phone-hint booking-phone-error" data-validate required />
      <span class="field-hint" id="booking-phone-hint">Вкажіть номер із кодом оператора або країни.</span>
      <span class="field-error" id="booking-phone-error"></span>
    </div>

    <div class="field field-wide">
      <label for="booking-service">Послуга <span aria-hidden="true">*</span></label>
      <select id="booking-service" name="service" aria-describedby="booking-service-hint booking-service-error" data-validate required>
        <option value="">Оберіть послугу</option>
        {serviceOptions.map((service) => <option value={service}>{service}</option>)}
      </select>
      <span class="field-hint" id="booking-service-hint">Доступність послуги підтвердимо окремо.</span>
      <span class="field-error" id="booking-service-error"></span>
    </div>

    <div class="field">
      <label for="booking-date">Бажана дата <span aria-hidden="true">*</span></label>
      <input id="booking-date" name="date" type="date" aria-describedby="booking-date-hint booking-date-error" data-validate required />
      <span class="field-hint" id="booking-date-hint">Сьогодні або пізніше.</span>
      <span class="field-error" id="booking-date-error"></span>
    </div>

    <div class="field">
      <label for="booking-time">Бажаний час <span aria-hidden="true">*</span></label>
      <input id="booking-time" name="time" type="time" aria-describedby="booking-time-hint booking-time-error" data-validate required />
      <span class="field-hint" id="booking-time-hint">Час потребує підтвердження.</span>
      <span class="field-error" id="booking-time-error"></span>
    </div>

    <div class="consent-field field-wide">
      <input id="booking-consent" name="consent" type="checkbox" value="accepted" aria-describedby="booking-consent-error" data-validate required />
      <label for="booking-consent">Погоджуюся підготувати SMS із введеними контактними даними. Сайт не зберігає їх і не надсилає на сервер.</label>
      <span class="field-error" id="booking-consent-error"></span>
    </div>

    <div class="privacy-note field-wide">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24"><path d="M12 3 5.5 5.6v5.7c0 4.4 2.7 8.3 6.5 9.7 3.8-1.4 6.5-5.3 6.5-9.7V5.6L12 3Zm0 2.2 4.5 1.8v4.3c0 3.3-1.9 6.3-4.5 7.5-2.6-1.2-4.5-4.2-4.5-7.5V7L12 5.2Z" /></svg>
      <p><strong>Не додавайте медичні дані.</strong> Для запису достатньо контактів, послуги та бажаного часу.</p>
    </div>

    <div class="form-actions field-wide">
      <button class="submit-button" type="submit">
        <span data-submit-label>Підготувати SMS</span>
        <span aria-hidden="true">→</span>
      </button>
      <p>Альтернатива: <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></p>
    </div>

    <p class="submit-status field-wide" data-submit-status role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  document.querySelectorAll('[data-appointment-form]').forEach((node) => {
    if (!(node instanceof HTMLFormElement) || node.dataset.enhanced === 'true') return;
    node.dataset.enhanced = 'true';
    const form = node;
    type BookingField = HTMLInputElement | HTMLSelectElement;
    const fields = Array.from(form.querySelectorAll<BookingField>('[data-validate]'));
    const dateField = form.elements.namedItem('date');
    const summary = form.querySelector('[data-error-summary]');
    const errorList = form.querySelector('[data-error-list]');
    const status = form.querySelector('[data-submit-status]');
    const submit = form.querySelector('button[type="submit"]');
    const submitLabel = form.querySelector('[data-submit-label]');
    let startedEventSent = false;
    let submitting = false;

    const today = () => {
      const now = new Date();
      const offset = now.getTimezoneOffset() * 60_000;
      return new Date(now.getTime() - offset).toISOString().slice(0, 10);
    };
    if (dateField instanceof HTMLInputElement) dateField.min = today();

    const dispatchStarted = () => {
      if (startedEventSent) return;
      startedEventSent = true;
      window.dispatchEvent(new CustomEvent('likar:booking_started', { detail: { form: 'appointment_request' } }));
    };

    const errorMessage = (field: BookingField) => {
      const value = field instanceof HTMLInputElement && field.type === 'checkbox' ? (field.checked ? field.value : '') : field.value.trim();
      if (field.name === 'name') {
        if (!value) return 'Вкажіть ім’я та прізвище.';
        if (Array.from(value).filter((character) => /\p{L}/u.test(character)).length < 2) return 'Введіть щонайменше дві літери.';
      }
      if (field.name === 'phone') {
        if (!value) return 'Вкажіть номер телефона.';
        if (!/^\+?[\d\s().-]+$/.test(value)) return 'Використовуйте лише цифри та символи + ( ) . -';
        const digitCount = value.replace(/\D/g, '').length;
        if (digitCount < 10 || digitCount > 15) return 'Введіть номер, що містить від 10 до 15 цифр.';
      }
      if (field.name === 'service' && !value) return 'Оберіть послугу.';
      if (field.name === 'date') {
        if (!value) return 'Оберіть бажану дату.';
        if (field.validity.badInput) return 'Введіть дату у правильному форматі.';
        if (value < today()) return 'Оберіть сьогоднішню або майбутню дату.';
      }
      if (field.name === 'time') {
        if (!value) return 'Оберіть бажаний час.';
        if (field.validity.badInput) return 'Введіть час у правильному форматі.';
      }
      if (field.name === 'consent' && !value) return 'Підтвердьте згоду на підготовку SMS.';
      return '';
    };

    const validateField = (field: BookingField) => {
      const message = errorMessage(field);
      const error = document.getElementById(`${field.id}-error`);
      field.setCustomValidity(message);
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (error) error.textContent = message;
      return !message;
    };

    const hideSummary = () => {
      if (summary instanceof HTMLElement) summary.hidden = true;
      if (errorList) errorList.replaceChildren();
    };

    form.addEventListener('input', (event) => {
      dispatchStarted();
      const field = event.target;
      if ((field instanceof HTMLInputElement || field instanceof HTMLSelectElement) && field.matches('[data-validate]') && field.getAttribute('aria-invalid') === 'true') validateField(field);
    });
    form.addEventListener('change', (event) => {
      dispatchStarted();
      const field = event.target;
      if ((field instanceof HTMLInputElement || field instanceof HTMLSelectElement) && field.matches('[data-validate]')) validateField(field);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (submitting) return;
      hideSummary();
      const invalidFields = fields.filter((field) => !validateField(field));
      if (invalidFields.length) {
        invalidFields.forEach((field) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${field.id}`;
          link.textContent = errorMessage(field);
          item.append(link);
          errorList?.append(item);
        });
        if (summary instanceof HTMLElement) {
          summary.hidden = false;
          summary.focus();
        }
        return;
      }

      submitting = true;
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Відкриваємо SMS…';
      if (status) status.textContent = 'Готуємо повідомлення. Перевірте текст перед надсиланням.';

      const data = new FormData(form);
      const dateValue = String(data.get('date'));
      const formattedDate = new Intl.DateTimeFormat('uk-UA', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(`${dateValue}T00:00:00`));
      const message = [
        'Вітаю! Хочу залишити запит на запис у «Лікар Поруч».',
        `Ім’я: ${String(data.get('name')).trim()}`,
        `Телефон: ${String(data.get('phone')).trim()}`,
        `Послуга: ${String(data.get('service'))}`,
        `Бажані дата й час: ${formattedDate}, ${String(data.get('time'))}`,
        'Розумію, що дату й час потрібно підтвердити.',
      ].join('\n');
      const endpoint = form.dataset.bookingEndpoint || '';
      const separator = /iPad|iPhone|iPod/.test(navigator.userAgent) ? '&' : '?';
      const smsUrl = `${endpoint}${separator}body=${encodeURIComponent(message)}`;
      window.dispatchEvent(new CustomEvent('likar:booking_submitted', { detail: { form: 'appointment_request', channel: 'sms' } }));
      window.location.assign(smsUrl);
      window.setTimeout(() => {
        submitting = false;
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
        if (submitLabel) submitLabel.textContent = 'Спробувати ще раз';
        if (status) status.textContent = 'Якщо SMS-застосунок не відкрився, спробуйте ще раз або зателефонуйте нам.';
      }, 1800);
    });
  });
</script>

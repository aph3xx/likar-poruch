<script>
  const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY?.trim();
  const posthogHost =
    import.meta.env.PUBLIC_POSTHOG_HOST?.trim() || 'https://eu.i.posthog.com';
  const doNotTrackEnabled =
    navigator.doNotTrack === '1' || navigator.doNotTrack === 'yes';
  type PostHogClient = typeof import('posthog-js').default;
  let posthog: PostHogClient | null = null;
  let sdkLoad: Promise<PostHogClient> | null = null;
  let initialized = false;
  let consentEnabled = false;

  const disableAnalytics = () => {
    consentEnabled = false;
    if (!initialized || !posthog) return;
    posthog.opt_out_capturing();
    // reset() performs a feature-flags request. Withdrawal must be silent, so
    // clear the SDK's local identity/session stores without invoking its
    // networked reset lifecycle.
    posthog.persistence?.clear();
    posthog.sessionPersistence?.clear();
  };

  const loadPostHog = async () => {
    if (!sdkLoad) {
      sdkLoad = import('posthog-js').then((module) => module.default);
    }
    return sdkLoad;
  };

  const enableAnalytics = async () => {
    if (!posthogKey || doNotTrackEnabled) return;
    consentEnabled = true;
    if (!initialized) {
      const client = await loadPostHog();
      if (!consentEnabled) return;
      posthog = client;
      posthog.init(posthogKey, {
        api_host: posthogHost,
        person_profiles: 'identified_only',
        capture_pageview: true,
        capture_pageleave: true,
        disable_session_recording: true,
        autocapture: false,
        cookieless_mode: 'always',
        respect_dnt: true,
      });
      initialized = true;
      window.addEventListener('likar:booking_started', () => { if (consentEnabled) client.capture('booking_started'); });
      window.addEventListener('likar:booking_submitted', () => { if (consentEnabled) client.capture('booking_submitted'); });
    } else if (posthog) {
      posthog.opt_in_capturing();
    }
  };

  window.addEventListener('likar:consent-changed', (event) => {
    const consent = (event as CustomEvent<{ purposes?: { analytics?: boolean } }>).detail;
    if (consent?.purposes?.analytics === true) enableAnalytics();
    else disableAnalytics();
  });

  // CookieConsent is loaded before this component; only a stored affirmative
  // choice may initialize the SDK. Absence or expiry remains denied.
  try {
    const stored = JSON.parse(localStorage.getItem('likar-consent-v1') || 'null');
    const now = Date.now();
    const allowedActions = new Set(['accept_all', 'reject_all', 'save_preferences']);
    if (stored?.version === '2026-10-16' && typeof stored.timestamp === 'number' && Number.isFinite(stored.timestamp) && stored.timestamp <= now && stored.timestamp >= now - 180 * 24 * 60 * 60 * 1000 && stored?.purposes && typeof stored.purposes.analytics === 'boolean' && allowedActions.has(stored.action) && stored.purposes.analytics === true) enableAnalytics();
  } catch (_) { /* optional storage is unavailable; remain denied */ }
</script>

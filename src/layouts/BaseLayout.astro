---
import '../styles/global.css';
import siteSettings from '../data/site.json';
import PostHogAnalytics from '../components/PostHogAnalytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
interface Props { title:string; description:string; path?:string; image?:string; type?:'website'|'article'|'profile'; noindex?:boolean; schema?:Record<string,unknown>|Record<string,unknown>[]; }
const { title, description, path='/', image='/images/clinic-doctor.webp', type='website', noindex=false, schema } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = Astro.site?.origin || 'https://aph3xx.github.io';
const normalizedPath = path === '/' ? '/' : `/${path.replace(/^\/+|\/+$/g, '')}/`;
const canonical = `${siteOrigin}${base}${normalizedPath}`;
const imageUrl = image.startsWith('http') ? image : `${siteOrigin}${base}${image}`;
const nav = [
  { href:'/posluhy/', label:'Послуги' },
  { href:'/pro-nas/', label:'Про центр' },
  { href:'/zhurnal/', label:'Матеріали' },
  { href:'/kontakty/', label:'Контакти' },
  { href:'/zapys/', label:'Запис' }
];
const href = (value:string) => `${base}${value}`;
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="uk" href={canonical} /><link rel="alternate" hreflang="x-default" href={canonical} />
  <meta name="robots" content={noindex?'noindex, nofollow':'index, follow, max-image-preview:large'} /><meta name="theme-color" content="#0b2d69" />
  <meta property="og:locale" content="uk_UA" /><meta property="og:type" content={type} /><meta property="og:site_name" content={siteSettings.name} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} /><meta property="og:image:alt" content="Медичний центр «Лікар Поруч»" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={imageUrl} />
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" /><link rel="manifest" href={href('/manifest.webmanifest')} />
  <link rel="alternate" type="application/rss+xml" title="Матеріали Лікар Поруч" href={href('/rss.xml')} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <a class="skip-link" href="#content">Перейти до вмісту</a>
  <header class="site-header"><div class="header-inner">
    <a class="brand" href={href('/')} aria-label={`${siteSettings.name}, головна`}><img class="brand-logo" src={href('/brand/mark.svg')} alt="" width="34" height="38" /><span>{siteSettings.name}</span></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span><span class="sr-only">Відкрити меню</span></button>
    <nav id="site-nav" class="site-nav" aria-label="Основна навігація">{nav.map((item)=><a href={href(item.href)}>{item.label}</a>)}</nav>
    <a class="header-cta" href={href('/zapys/')}>Записатися</a>
  </div></header>
  <main id="content"><slot /></main>
  <footer class="site-footer"><div class="footer-grid">
    <div><a class="brand brand-light" href={href('/')}><img class="brand-logo" src={href('/brand/mark-inverse.svg')} alt="" width="34" height="38" /><span>{siteSettings.name}</span></a><p class="footer-lead">{siteSettings.tagline}</p><p class="demo-note">{siteSettings.demoNotice}</p></div>
    <div><h2>Медичний центр</h2><a href={href('/posluhy/')}>Послуги</a><a href={href('/pro-nas/')}>Про центр</a><a href={href('/kontakty/')}>Контакти</a></div>
    <div><h2>Зв’язок</h2><a href={`tel:${siteSettings.phone}`}>{siteSettings.phoneDisplay}</a><p>{siteSettings.address}</p><a href={href('/privacy/')}>Приватність</a><button type="button" class="footer-privacy-link" data-consent-open>Налаштування приватності</button></div>
    <div><h2>Важливо</h2><p>{siteSettings.emergencyNotice}</p><p>{siteSettings.medicalDisclaimer}</p></div>
  </div><div class="footer-bottom"><span>© 2026 {siteSettings.name}</span><span>Приватна медична практика</span></div></footer>
  <CookieConsent />
  <PostHogAnalytics />
  <script is:inline>
    const toggle=document.querySelector('.menu-toggle');const nav=document.querySelector('#site-nav');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('is-open',!open);});
  </script>
</body></html>
